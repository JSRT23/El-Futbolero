# ── Obligatorias (la app no arranca sin ellas) ─────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ── Solo para el sincronizador de partidos (docker compose --profile sync) ──
# NO las subas a GitHub: la service role salta toda la seguridad por fila.
FOOTBALL_DATA_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# ── Opcionales ─────────────────────────────────────────────────────────────
# PORT=8080        # puerto de la versión de producción
# DEV_PORT=5173    # puerto del modo desarrollo
